/*------------------------------------------ Définition des bits permanents du module ----------------------------------------*/
/* IO_COMM:      Bit de communication positionné par le thread lui-meme                                                       */
 #define IO_COMM      <-> _WATCHDOG(libelle="Etat communication avec le module METEO $THIS");
 #define MSG_COMM_NOK <-> _MSG(type=danger, libelle="Unité METEO $THIS hors service", notif_sms=no, notif_chat=yes );

 #define SUNRISE      <-> _HORLOGE(libelle="Lever du soleil");
 #define SUNSET       <-> _HORLOGE(libelle="Coucher du soleil");

/* Prévisions: DAY0 = aujourd'hui, jusqu'à DAY13 */
