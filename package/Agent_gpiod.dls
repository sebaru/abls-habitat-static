/******************************************************************************************************************************/
/* Module DLS de gestion de l'agent 'GPIOD'                                                                                   */
/* Auteurs : Sébastien Lefevre - sebastien.lefevre@abls-habitat.fr                                                            */
/* Date : 28/09/2026                                                                                                          */
/* Les DI/DO des lignes GPIO sont définies par la configuration de l'agent et mappées sur d'autres plugins.                   */
/******************************************************************************************************************************/

/*------------------------------------------ Définition des bits permanents du module ----------------------------------------*/
/* IO_COMM:      Bit de communication positionné par l'agent lui-meme                                                         */
 #define IO_COMM      <-> _WATCHDOG(libelle="Etat communication avec le module GPIO $THIS");
 #define MSG_COMM_NOK <-> _MSG(type=danger, libelle="Module GPIO $THIS hors service", notif_sms=yes, notif_chat=yes );

/* Bits communs créés par chaque agent */
 #define TOUR_PAR_SEC    <-> _AI(libelle="Nombre de tours par seconde");
 #define MEMORY_RSS      <-> _AI(libelle="Mémoire RSS");
 #define MEMORY_VIRTUAL  <-> _AI(libelle="Mémoire virtuelle");
 #define LOG_PAR_MIN     <-> _AI(libelle="Logs par minute");

/*------------------------------------------ Définition des bits locaux au module --------------------------------------------*/
 #define VISU_THREAD  <-> _I(forme="check", libelle="Module GPIO");

/*------------------------------------------------- Logique fonctionnelle ----------------------------------------------------*/

 - IO_COMM -> VISU_THREAD(mode="checked", libelle="$THIS connecté");
 -/IO_COMM -> MEMSA_DEFAUT, MEMSSP_DANGER,
              VISU_THREAD(mode="unchecked", cligno, libelle="$THIS déconnecté"),
              MSG_COMM_NOK;

/* Pilotage des bits de remontées */
 - _TRUE -> MEMSSB_VEILLE;

/*----------------------------------------------------------------------------------------------------------------------------*/
